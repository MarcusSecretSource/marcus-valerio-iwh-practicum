doctype html
html
    head
        title= title
        link(rel="stylesheet" href="/css/style.css")
    body
        a(href="/update-cobj") Add to this table
        h1 Drivers
        table
            tr
                th Name
                th Team
                th Age
            each record in records
                tr
                    td= record.properties.name 
                    td= record.properties.team 
                    td= record.properties.age